# Copy this file to .env and fill in your values — .env is git-ignored and never uploaded to GitHub
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI keys (Anthropic, OpenAI) are NOT set here — anything starting with VITE_ ends up
# in the public website. They are stored as Supabase secrets instead:
#   supabase secrets set ANTHROPIC_API_KEY=... OPENAI_API_KEY=...
